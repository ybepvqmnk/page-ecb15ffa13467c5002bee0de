          "version": 3,
          "body": "<style>\n  :root{--cream:#f4efe6;--cream-2:#ece4d6;--brick:#a63c2a;--brick-deep:#7d2b1e;--ink:#241d19;--ink-soft:#5b4f47;--line:#c9b9a5;--paper:#fbf7f0}\n  *{box-sizing:border-box}\n  html{-webkit-text-size-adjust:100%}\n  body{margin:0;background:var(--cream);color:var(--ink);font-family:\"Segoe UI\",\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:16px;line-height:1.75;letter-spacing:.01em}\n  a{color:var(--brick);text-decoration:none;border-bottom:1px solid rgba(166,60,42,.35)}\n  a:hover{border-bottom-color:var(--brick)}\n  p{margin:0 0 1em}\n  h1,h2,h3{font-weight:700;line-height:1.25;margin:0}\n  .wrap{width:100%;max-width:1080px;margin:0 auto;padding:0 22px}\n\n  /* ---------- 全宽色带分层堆叠首屏 ---------- */\n  .band{padding:0}\n  .band-a{background:var(--cream-2);border-bottom:1px solid var(--line)}\n  .band-a-inner{padding:14px 0;display:flex;flex-wrap:wrap;gap:10px 26px;align-items:baseline;justify-content:space-between;font-size:.82rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}\n  .band-a-inner .tagmark{color:var(--brick);font-weight:700;letter-spacing:.2em}\n  .band-a-inner nav{display:flex;flex-wrap:wrap;gap:8px 20px}\n  .band-a-inner nav a{color:var(--ink-soft);border-bottom:1px dotted var(--line);font-size:.82rem;letter-spacing:.12em}\n  .band-a-inner nav a:hover{color:var(--brick);border-bottom-color:var(--brick)}\n\n  .band-b{background:var(--brick);color:var(--paper)}\n  .band-b-inner{padding:64px 0 58px}\n  .kicker{font-size:.78rem;letter-spacing:.3em;text-transform:uppercase;opacity:.85;margin:0 0 18px}\n  .band-b h1{font-size:clamp(2.4rem,7vw,4.6rem);letter-spacing:-.01em;margin:0 0 20px;max-width:16ch}\n  .band-b h1 .thin{display:block;font-size:.36em;font-weight:400;letter-spacing:.02em;margin-top:14px;max-width:30ch;opacity:.92;line-height:1.6}\n  .band-b .lead{max-width:56ch;font-size:1.02rem;opacity:.95;margin:0}\n\n  .band-c{background:var(--paper);border-bottom:1px solid var(--line)}\n  .band-c-inner{padding:26px 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:18px 30px}\n  .factline{border-left:2px solid var(--brick);padding-left:14px}\n  .factline .fl-k{display:block;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--brick);margin-bottom:4px}\n  .factline .fl-v{display:block;font-size:.95rem;color:var(--ink)}\n\n  /* ---------- 通用区块 ---------- */\n  section{padding:0}\n  .sec-head{padding:56px 0 26px}\n  .sec-head .num{font-size:.74rem;letter-spacing:.26em;color:var(--brick);text-transform:uppercase;display:block;margin-bottom:10px}\n  .sec-head h2{font-size:clamp(1.5rem,3.4vw,2.1rem)}\n  .sec-head .sub{margin-top:12px;max-width:62ch;color:var(--ink-soft)}\n  .rule{height:1px;background:var(--line);border:0;margin:0}\n\n  .sec-body{padding-bottom:64px}\n\n  /* ---------- 票据虚线卡片 ---------- */\n  .ticket{background:var(--paper);border:1px dashed var(--brick);padding:22px 24px;position:relative}\n  .ticket + .ticket{margin-top:18px}\n  .ticket::before,.ticket::after{content:\"\";position:absolute;width:16px;height:16px;background:var(--cream);border:1px dashed var(--brick);border-radius:50%;top:-9px}\n  .ticket::before{left:-9px}\n  .ticket::after{right:-9px}\n\n  /* ---------- 套餐纵向列表逐行展开 ---------- */\n  .plan-row{display:grid;grid-template-columns:minmax(0,240px) minmax(0,1fr);gap:0;border-top:1px solid var(--line);background:var(--paper)}\n  .plan-row:last-of-type{border-bottom:1px solid var(--line)}\n  .plan-row .pr-left{padding:26px 24px;border-right:1px dashed var(--brick);background:var(--cream-2)}\n  .plan-row.featured .pr-left{background:var(--brick);color:var(--paper)}\n  .plan-row.featured .pr-left .pr-price small{color:rgba(251,247,240,.8)}\n  .plan-row.featured .pr-left .pr-name{color:var(--paper)}\n  .plan-row.featured .pr-left .pr-flag{background:var(--paper);color:var(--brick-deep);border-color:var(--paper)}\n  .pr-name{font-size:1.24rem;margin:0 0 6px;letter-spacing:.02em}\n  .pr-flag{display:inline-block;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;border:1px solid var(--brick);color:var(--brick);padding:1px 8px;margin-bottom:12px}\n  .pr-price{font-size:1.7rem;font-weight:700;letter-spacing:-.01em;margin:0}\n  .pr-price small{font-size:.82rem;font-weight:400;letter-spacing:.02em;color:var(--ink-soft);display:block;margin-top:6px}\n  .plan-row .pr-right{padding:24px 26px}\n  .pr-list{list-style:none;margin:0;padding:0}\n  .pr-list li{padding:7px 0 7px 24px;position:relative;font-size:.95rem;border-bottom:1px dotted var(--line)}\n  .pr-list li:last-child{border-bottom:0}\n  .pr-list li::before{content:\"\";position:absolute;left:2px;top:1.05em;width:8px;height:8px;border:1px solid var(--brick);transform:rotate(45deg)}\n  .plan-note{margin-top:20px;font-size:.86rem;color:var(--ink-soft)}\n\n  /* ---------- 使用说明 ---------- */\n  .steps{counter-reset:st;list-style:none;margin:0;padding:0;display:grid;gap:16px}\n  .steps li{counter-increment:st;background:var(--paper);border:1px dashed var(--brick);padding:20px 24px 20px 74px;position:relative}\n  .steps li::before{content:counter(st,decimal-leading-zero);position:absolute;left:22px;top:18px;font-size:1.5rem;font-weight:700;color:var(--brick);letter-spacing:.02em}\n  .steps h3{font-size:1.02rem;margin:0 0 6px}\n  .steps p{margin:0;font-size:.94rem;color:var(--ink-soft)}\n\n  /* ---------- 客户端区块 ---------- */\n  .client-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}\n  .client-card{background:var(--paper);border:1px dashed var(--brick);padding:20px 22px}\n  .client-card h3{font-size:1rem;margin:0 0 8px}\n  .client-card p{font-size:.9rem;color:var(--ink-soft);margin:0 0 10px}\n  .client-card .cw{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brick)}\n\n  /* ---------- FAQ 编号列表 ---------- */\n  .faq-list{list-style:none;margin:0;padding:0;counter-reset:fq}\n  .faq-list > li{counter-increment:fq;border-top:1px solid var(--line);padding:22px 0 22px 62px;position:relative}\n  .faq-list > li:last-child{border-bottom:1px solid var(--line)}\n  .faq-list > li::before{content:counter(fq,decimal-leading-zero);position:absolute;left:0;top:20px;font-size:.9rem;font-weight:700;color:var(--brick);letter-spacing:.06em}\n  .faq-q{font-size:1.02rem;margin:0 0 8px;font-weight:700}\n  .faq-a{margin:0;font-size:.94rem;color:var(--ink-soft)}\n\n  /* ---------- 正文说明两块 ---------- */\n  .two-col{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:26px}\n  .plain-block h3{font-size:1.05rem;margin:0 0 10px}\n  .plain-block p{font-size:.95rem;color:var(--ink-soft);margin:0 0 10px}\n\n  /* ---------- 页脚 ---------- */\n  footer{background:var(--cream-2);border-top:1px solid var(--line);padding:38px 0 44px;margin-top:10px}\n  .foot-inner{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px 34px;font-size:.88rem;color:var(--ink-soft)}\n  .foot-inner strong{color:var(--ink);font-size:1rem;letter-spacing:.16em}\n  .foot-links{display:flex;flex-wrap:wrap;gap:6px 18px}\n  .foot-links a{color:var(--ink-soft);border-bottom:1px dotted var(--line)}\n  .foot-links a:hover{color:var(--brick);border-bottom-color:var(--brick)}\n\n  @media (max-width:680px){\n    .band-b-inner{padding:46px 0 42px}\n    .plan-row{grid-template-columns:1fr}\n    .plan-row .pr-left{border-right:0;border-bottom:1px dashed var(--brick)}\n    .faq-list > li{padding-left:46px}\n    .steps li{padding:18px 18px 18px 62px}\n    .steps li::before{left:16px;font-size:1.28rem}\n  }\n</style><main>\n\n  <section class=\"band band-a\" aria-label=\"页首标识与页内锚点\">\n    <div class=\"wrap band-a-inner\">\n      <span class=\"tagmark\">Mysterious</span>\n      <nav aria-label=\"页内跳转\">\n        <a href=\"#plans\">订阅方案</a>\n        <a href=\"#howto\">使用说明</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#notes\">条款要点</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n  </section>\n\n  <section class=\"band band-b\" aria-label=\"首屏\">\n    <div class=\"wrap band-b-inner\">\n      <p class=\"kicker\">Mysterious · 方案与说明</p>\n      <h1>Mysterious\n        <span class=\"thin\">三档订阅，权益逐条写清楚。价格、流量、设备台数、线路差异都在页面上，不藏在弹窗里。</span>\n      </h1>\n      <p class=\"lead\">这页只做一件事：把 Mysterious 的订阅内容按行摊开，让你从流量、设备数、流媒体与专线四个维度对照，再决定要不要继续。没有倒计时，也没有滚动横幅。</p>\n    </div>\n  </section>\n\n  <section class=\"band band-c\" aria-label=\"方案概览\">\n    <div class=\"wrap band-c-inner\">\n      <div class=\"factline\">\n        <span class=\"fl-k\">档位</span>\n        <span class=\"fl-v\">基础版 / 旗舰版 / 团队版，共三档</span>\n      </div>\n      <div class=\"factline\">\n        <span class=\"fl-k\">计费</span>\n        <span class=\"fl-v\">月付与年付两种周期，年付按 10 个月计</span>\n      </div>\n      <div class=\"factline\">\n        <span class=\"fl-k\">流量</span>\n        <span class=\"fl-v\">100GB / 300GB / 1000GB 每月</span>\n      </div>\n      <div class=\"factline\">\n        <span class=\"fl-k\">设备</span>\n        <span class=\"fl-v\">3 台 / 5 台 / 20 台同时在线</span>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"wrap\">\n\n    <div class=\"sec-head\" id=\"plans\">\n      <span class=\"num\">01 / 订阅方案</span>\n      <h2>三档方案，逐行展开</h2>\n      <p class=\"sub\">每一行左侧是价格与周期，右侧是该档包含的权益。年付价格写在月付下方，两者不混算。所有金额为人民币含税标价。</p>\n    </div>\n\n    <div class=\"sec-body\">\n\n      <article class=\"plan-row\">\n        <div class=\"pr-left\">\n          <h3 class=\"pr-name\">基础版</h3>\n          <p class=\"pr-price\">¥15 / 月<small>按年付 ¥150 / 年</small></p>\n        </div>\n        <div class=\"pr-right\">\n          <ul class=\"pr-list\">\n            <li>每月 100GB 流量额度，按月重置</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </div>\n      </article>\n\n      <article class=\"plan-row featured\">\n        <div class=\"pr-left\">\n          <span class=\"pr-flag\">多数人选这档</span>\n          <h3 class=\"pr-name\">旗舰版</h3>\n          <p class=\"pr-price\">¥35 / 月<small>按年付 ¥350 / 年</small></p>\n        </div>\n        <div class=\"pr-right\">\n          <ul class=\"pr-list\">\n            <li>每月 300GB 流量额度，按月重置</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线，游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </div>\n      </article>\n\n      <article class=\"plan-row\">\n        <div class=\"pr-left\">\n          <h3 class=\"pr-name\">团队版</h3>\n          <p class=\"pr-price\">¥85 / 月<small>按年付 ¥850 / 年</small></p>\n        </div>\n        <div class=\"pr-right\">\n          <ul class=\"pr-list\">\n            <li>每月 1000GB 流量额度，按月重置</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </div>\n      </article>\n\n      <p class=\"plan-note\">说明：以上流量、设备台数与节点类型均以本页列为准；未在本页写明的性能指标、节点数量与线路覆盖，不做额外承诺。价格变动会先更新本页再对外说明。</p>\n\n    </div>\n\n    <hr class=\"rule\">\n\n    <div class=\"sec-head\" id=\"howto\">\n      <span class=\"num\">02 / 使用说明</span>\n      <h2>从下单到日常使用，五步</h2>\n      <p class=\"sub\">下面是不依赖任何具体客户端品牌的通用流程。每一步只描述你要完成的事，不描述你应当获得的体验。</p>\n    </div>\n\n    <div class=\"sec-body\">\n      <ol class=\"steps\">\n        <li>\n          <h3>先核对档位</h3>\n          <p>回到上方方案列表，按你的月度流量需求与同时在线设备数选档。设备数按「同时在线」计算，不是按装机次数计算。</p>\n        </li>\n        <li>\n          <h3>确认计费周期</h3>\n          <p>月付按月续，年付一次付清并折算为十个月的价格。周期在订购页选定，两侧价格以本页展示为准。</p>\n        </li>\n        <li>\n          <h3>取得配置信息</h3>\n          <p>完成订购后，你会获得用于配置客户端的账号信息。请把它当作密码管理，不随意转发给不在你设备清单内的人。</p>\n        </li>\n        <li>\n          <h3>在设备上完成配置</h3>\n          <p>按下方客户端说明选择与你系统对应的入口，导入配置后逐台确认连通情况。设备数量上限按档位执行。</p>\n        </li>\n        <li>\n          <h3>按需查看用量与更档</h3>\n          <p>流量按月重置。若发现月度额度长期吃紧或同时在线设备数不够，再考虑升档，不必一开始就买到最高档。</p>\n        </li>\n      </ol>\n    </div>\n\n    <hr class=\"rule\">\n\n    <div class=\"sec-head\" id=\"clients\">\n      <span class=\"num\">03 / 客户端</span>\n      <h2>先确认系统，再选入口</h2>\n      <p class=\"sub\">Mysterious 不自建客户端。下列为按系统分类的入口说明；具体下载渠道与版本，请以你订购后收到的说明为准，本页不提供外部下载地址。</p>\n    </div>\n\n    <div class=\"sec-body\">\n      <div class=\"client-grid\">\n        <div class=\"client-card\">\n          <span class=\"cw\">Windows</span>\n          <h3>桌面端</h3>\n          <p>用于台式机与笔记本。配置后请在设置中确认开机自启与系统代理两项是否为你想要的默认行为。</p>\n        </div>\n        <div class=\"client-card\">\n          <span class=\"cw\">macOS</span>\n          <h3>桌面端</h3>\n          <p>安装后首次启动需在系统设置中允许其网络权限，否则配置导入成功也不会生效。</p>\n        </div>\n        <div class=\"client-card\">\n          <span class=\"cw\">Android</span>\n          <h3>移动端</h3>\n          <p>移动网络与 Wi-Fi 下需分别验证一次连通性，部分系统会在省电模式下限制后台连接。</p>\n        </div>\n        <div class=\"client-card\">\n          <span class=\"cw\">iOS / iPadOS</span>\n          <h3>移动端</h3>\n          <p>通过系统网络扩展方式工作。切换 App Store 账号前，请先确认已安装版本仍在可用状态。</p>\n        </div>\n        <div class=\"client-card\">\n          <span class=\"cw\">Linux</span>\n          <h3>命令行</h3>\n          <p>适合在服务器或长期在线的设备上使用。建议以服务方式运行，并单独管理配置文件权限。</p>\n        </div>\n        <div class=\"client-card\">\n          <span class=\"cw\">Router</span>\n          <h3>路由器</h3>\n          <p>用于整网设备统一接入。团队版的定制路由需求需通过客户经理沟通，普通档位不包含该项。</p>\n        </div>\n      </div>\n    </div>\n\n    <hr class=\"rule\">\n\n    <div class=\"sec-head\" id=\"notes\">\n      <span class=\"num\">04 / 条款要点</span>\n      <h2>下单前请先读这四条</h2>\n      <p class=\"sub\">这几条不是营销文案，是用来减少后续沟通成本的说明。</p>\n    </div>\n\n    <div class=\"sec-body\">\n      <div class=\"two-col\">\n        <div class=\"plain-block\">\n          <h3>流量与设备</h3>\n          <p>流量按自然月重置，未用完的额度不结转到下月。设备上限按同时在线数计算，超出上限时新设备将无法连接。</p>\n          <p>年付与月付在流量与设备权益上完全一致，差别只在计费周期与折算价格。</p>\n        </div>\n        <div class=\"plain-block\">\n          <h3>服务边界</h3>\n          <p>本页未列出的性能数值、节点数量、线路覆盖率与可用性指标，均不构成承诺。流媒体解锁能力受平台策略变化影响，可能随时调整。</p>\n          <p>若所在地区对相关服务有明确限制，请自行确认合规性后再决定是否订购。</p>\n        </div>\n      </div>\n    </div>\n\n    <hr class=\"rule\">\n\n    <div class=\"sec-head\" id=\"faq\">\n      <span class=\"num\">05 / 常见问题</span>\n      <h2>常见问题，按编号逐条回答</h2>\n      <p class=\"sub\">以下问题的答案与页面上方的方案列表一致。若两者出现不一致，以方案列表为准，并请通过工单告知我们修订。</p>\n    </div>\n\n    <div class=\"sec-body\">\n      <ol class=\"faq-list\">\n        <li>\n          <h3 class=\"faq-q\">年付比月付省多少？怎么算的？</h3>\n          <p class=\"faq-a\">年付价格按月付价×10 折算：基础版 ¥150、旗舰版 ¥350、团队版 ¥850。也就是说，按年付相当于为十二个月支付十个月的费用，具体金额已写在各自方案的价格行内。</p>\n        </li>\n        <li>\n          <h3 class=\"faq-q\">三档之间最关键的差别是什么？</h3>\n          <p class=\"faq-a\">两个可量化的差别是月度流量与同时在线设备数，分别是 100GB/3 台、300GB/5 台、1000GB/20 台。其余差别在权益层面：旗舰版起包含全节点原生流媒体解锁与 IPLC 专线游戏加速优化，团队版另含 VIP 专属高带宽节点、企业定制路由与专属客户经理。</p>\n        </li>\n        <li>\n          <h3 class=\"faq-q\">中途想升档，原来的流量怎么处理？</h3>\n          <p class=\"faq-a\">升档后按新档位的月度额度执行，设备上限同步调整。已使用的流量不追溯退回，也不额外扣费。降档同理，从新周期起按低档额度执行，建议在月度重置前后操作以减少浪费。</p>\n        </li>\n        <li>\n          <h3 class=\"faq-q\">设备上限里的「同时在线」怎么理解？</h3>\n          <p class=\"faq-a\">指同一时间保持连接状态的设备数量。关闭客户端或被系统挂起的设备不计入。若你在手机与电脑间频繁切换，通常不需要按设备总数购买更高档位；但若多台设备需要长时间保持连接，请按实际在线台数选档。</p>\n        </li>\n        <li>\n          <h3 class=\"faq-q\">客户端由 Mysterious 提供吗？</h3>\n          <p class=\"faq-a\">不是。我们提供配置信息与按系统划分的接入说明，客户端由各平台上的第三方软件承担。本页不提供下载地址，也不会要求你从非官方渠道安装额外组件。</p>\n        </li>\n        <li>\n          <h3 class=\"faq-q\">团队版的定制路由需要准备什么？</h3>\n          <p class=\"faq-a\">需要说明你的网络环境、需要统一接入的设备规模，以及是否存在特定的走向要求。这些信息由专属客户经理对接确认。定制路由属于团队版权益，基础版与旗舰版不包含该项。</p>\n        </li>\n        <li>\n          <h3 class=\"faq-q\">流媒体解锁为什么可能变化？</h3>\n          <p class=\"faq-a\">解锁能力取决于平台自身的识别与调整策略，不由我们单方面决定。我们会在能力发生变化时更新说明，但不承诺某个具体平台在任意时刻都可用。基础版为「基础流媒体解锁」，与旗舰版起的「全节点原生流媒体解锁」不是同一范围。</p>\n        </li>\n      </ol>\n    </div>\n\n  </div>\n\n  <footer>\n    <div class=\"wrap foot-inner\">\n      <div>\n        <strong>MYSTERIOUS</strong>\n        <p>方案、价格与权益以本页所列内容为准。未列明的指标不作承诺。</p>\n      </div>\n      <div>\n        <p>页内跳转</p>\n        <div class=\"foot-links\">\n          <a href=\"#plans\">订阅方案</a>\n          <a href=\"#howto\">使用说明</a>\n          <a href=\"#clients\">客户端</a>\n          <a href=\"#notes\">条款要点</a>\n          <a href=\"#faq\">常见问题</a>\n        </div>\n      </div>\n      <div>\n        <p>联系与说明</p>\n        <p>工单入口与订购流程在你完成订购后提供；本页不含外部下载链接，也不代收任何款项。</p>\n      </div>\n    </div>\n  </footer>\n\n</main>",
